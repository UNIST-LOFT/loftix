POC_INPUT="poc/heapoverflow.tiff"
POC_DIR="poc"
BINARY="tiff2ps"
GUIX_SPEC="libtiff-static@4.0.7"
TEST_CMD="@@"
# SDFuzz build settings
BINARY_BASENAME="tiff2ps"
CONFIGURE_FLAGS="--disable-cxx"
MAKE_BUILD_TARGET="all"
MAKE_BINARY_TARGET=""
MAKE_BINARY_SUBDIR="tools"
SANITIZER_FLAGS="-fsanitize=address"
