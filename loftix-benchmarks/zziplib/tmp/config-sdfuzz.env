# SDFuzz configuration for CVE-2017-14940
# nm: DWARF null dereference in read_and_display_attr_value (dwarf2.c)

# Build settings
VERSION="2.29"

# Target locations for directed fuzzing (file:line)
# The null dereference occurs in bfd/dwarf2.c when processing DWARF debug info
BB_TARGETS="dwarf2.c:1874"

# Binary to fuzz
BINARY="nm"
TEST_ARGS="-l @@"

# SDFuzz settings
MEMORY_LIMIT=none
CYCLE_LIMIT=45m
EXPSCHEDULE="exp"
