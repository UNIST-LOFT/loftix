+_CONTINUATION_END = set("+-*/%<>=&|!?:,(")
+
+
+def _v1_insert_point(lines: list[str], lineno: int) -> int:
+    """Return the index at which to insert the v1 calls for `lineno`.
+
+    Inserting before the target line is only safe when that line starts a
+    statement.  If it is a continuation of a multi-line expression (the
+    previous line ends with an operator or open paren, or the line itself
+    starts with a continuation token), insert after the end of the
+    statement instead (the first line ending with ';' at paren depth 0),
+    skipping any else / else-if clauses so we never land between an if
+    body and its else.
+    """
+    target = lines[lineno - 1]
+    stripped = target.lstrip()
+    prev = lines[lineno - 2].rstrip() if lineno >= 2 else ""
+    continuation = (
+        not stripped
+        or stripped[0] in "*+-/),&|?:;"
+        or (prev and prev[-1] in _CONTINUATION_END)
+    )
+    if not continuation:
+        return lineno - 1
+    depth = 0
+    end = lineno - 1
+    for i in range(lineno - 1, len(lines)):
+        line = lines[i]
+        for ch in line:
+            if ch == "(":
+                depth += 1
+            elif ch == ")":
+                depth -= 1
+        if depth <= 0 and ";" in line:
+            end = i + 1
+            break
+    i = end
+    while i < len(lines):
+        nxt = lines[i].lstrip()
+        if not nxt.startswith("else"):
+            break
+        i += 1
+        if i < len(lines) and lines[i].lstrip().startswith("{"):
+            depth = 0
+            while i < len(lines):
+                for ch in lines[i]:
+                    if ch == "{":
+                        depth += 1
+                    elif ch == "}":
+                        depth -= 1
+                i += 1
+                if depth <= 0:
+                    break
+        else:
+            depth = 0
+            while i < len(lines):
+                for ch in lines[i]:
+                    if ch == "(":
+                        depth += 1
+                    elif ch == ")":
+                        depth -= 1
+                if depth <= 0 and ";" in lines[i]:
+                    i += 1
+                    break
+                i += 1
+    return i
+
+
